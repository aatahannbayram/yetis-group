// Yetiş Grup - Prisma schema (M12.5 structural target)
// Dealer is the only commercial entity (no separate Customer table).
// SKU / price / stock / lots live on ProductVariant.
// Cart is server-side. Order lines arrive in M4 on variantId.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (better-auth) ----

enum UserAccountType {
  STAFF
  DEALER
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  phoneNumber   String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accountType UserAccountType @default(DEALER)
  /// Legacy per-user price list; prefer Dealer.priceListId. Kept for STAFF tooling.
  priceListId String?
  priceList   PriceList?      @relation(fields: [priceListId], references: [id])

  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  sessions       Session[]
  accounts       Account[]
  dealerRoles    DealerUserRole[]
  carts          Cart[]
  salesRepOf     Dealer[]         @relation("DealerSalesRep")
  stageAudits    LeadStageAudit[]
  assignedLeads  Lead[]           @relation("LeadAssignee")
  leadTasks      LeadTask[]       @relation("LeadTaskAssignee")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---- Dealer (single commercial entity; no Customer table) ----

enum DealerType {
  BAYI
  HORECA
  ZINCIR
  ARA_TOPTANCI
}

enum DealerStatus {
  BASVURU
  INCELEME
  ONAYLI
  AKTIF
  RISKLI
  BLOKE
  PASIF
}

enum DealerRole {
  YETKILI
  SATIN_ALMA
  MUHASEBE
  DEPO
}

enum MembershipTier {
  STANDART
  PREMIUM
  VIP
}

enum DealerPaymentMethod {
  VADELI
  PESIN
  HAVALE
  KARMA
}

model Dealer {
  id                   String               @id @default(cuid())
  unvan                String
  vergiNo              String?
  vergiDairesi         String?
  dealerType           DealerType
  status               DealerStatus         @default(BASVURU)
  membershipTier       MembershipTier?
  email                String?
  phone                String?
  addressLine          String?
  city                 String?
  district             String?
  deliveryAddressLine  String?
  paymentMethod        DealerPaymentMethod?
  iban                 String?
  creditLimitKurus     Int?
  paymentTermDays      Int?
  deliveryZoneCode     String?
  priceListId          String?
  priceList            PriceList?           @relation(fields: [priceListId], references: [id])
  salesRepId           String?
  salesRep             User?                @relation("DealerSalesRep", fields: [salesRepId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  users         User[]
  roles         DealerUserRole[]
  carts         Cart[]
  fromLeads     Lead[]          @relation("LeadConvertedDealer")
  ledgerEntries LedgerEntry[]
  shipments     Shipment[]
  orders        Order[]

  @@map("dealer")
}

// ---- Cari (append-only ledger; balance is always derived, never stored) ----

enum LedgerEntryType {
  BORC
  ODEME
}

model LedgerEntry {
  id          String          @id @default(cuid())
  dealerId    String
  dealer      Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amountKurus Int
  description String
  reversesId  String?         @unique
  reverses    LedgerEntry?    @relation("LedgerReversal", fields: [reversesId], references: [id])
  reversedBy  LedgerEntry?    @relation("LedgerReversal")
  createdAt   DateTime        @default(now())

  @@index([dealerId, createdAt])
  @@map("ledger_entry")
}

model DealerUserRole {
  id        String     @id @default(cuid())
  dealerId  String
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      DealerRole
  createdAt DateTime   @default(now())

  @@unique([dealerId, userId])
  @@map("dealer_user_role")
}

// ---- CRM Lead ----

enum LeadChannel {
  MARKET
  SARKUTERI
  HORECA
  ARA_TOPTANCI
}

enum LeadStage {
  YENI
  ILETISIMDE
  NITELIKLI
  NUMUNE
  NUMUNE_TEKLIF
  TEKLIF
  MUZAKERE
  KAZANILDI
  KAYBEDILDI
}

enum LeadSource {
  ILETISIM_FORMU
  BAYILIK_BASVURUSU
  MALIYET_HESAPLAYICI
  BULTEN
  WHATSAPP
  NUMUNE_TALEBI
  MANUEL
}

model Lead {
  id                   String      @id @default(cuid())
  companyName          String
  contactName          String
  phone                String
  email                String?
  city                 String
  channel              LeadChannel
  stage                LeadStage   @default(YENI)
  source               LeadSource  @default(MANUEL)
  estimatedMonthlyKg   Decimal?    @db.Decimal(10, 3)
  note                 String?
  lostReason           String?
  interestedCategoryId String?
  interestedCategory   Category?   @relation(fields: [interestedCategoryId], references: [id])
  assigneeId           String?
  assignee             User?       @relation("LeadAssignee", fields: [assigneeId], references: [id])
  kvkkConsentAt        DateTime?
  convertedDealerId    String?
  convertedDealer      Dealer?     @relation("LeadConvertedDealer", fields: [convertedDealerId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  activities  LeadActivity[]
  audits      LeadStageAudit[]
  fieldValues LeadFieldValue[]
  tasks       LeadTask[]

  @@index([source, createdAt])
  @@index([assigneeId])
  @@map("lead")
}

enum LeadActivityType {
  ARAMA
  NOT
  TEKLIF
  TESLIMAT
  DURUM_DEGISIKLIGI
  EMAIL
  WHATSAPP
  FORM
  GOREV
  HATIRLATMA
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  note      String
  createdAt DateTime         @default(now())

  @@map("lead_activity")
}

model LeadStageAudit {
  id         String     @id @default(cuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage  LeadStage?
  toStage    LeadStage
  reason     String?
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id])
  createdAt  DateTime   @default(now())

  @@map("lead_stage_audit")
}

enum LeadFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
}

model LeadFieldDefinition {
  id          String        @id @default(cuid())
  key         String        @unique
  label       String
  type        LeadFieldType @default(TEXT)
  /// SELECT / MULTI_SELECT options as string[]
  options     Json          @default("[]")
  required    Boolean       @default(false)
  formVisible Boolean       @default(true)
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  values LeadFieldValue[]

  @@map("lead_field_definition")
}

model LeadFieldValue {
  id        String              @id @default(cuid())
  leadId    String
  lead      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fieldId   String
  field     LeadFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valueText String?
  valueNum  Decimal?            @db.Decimal(14, 3)
  valueDate DateTime?
  valueJson Json?

  @@unique([leadId, fieldId])
  @@map("lead_field_value")
}

model LeadTask {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String
  dueAt      DateTime?
  doneAt     DateTime?
  assigneeId String?
  assignee   User?     @relation("LeadTaskAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([leadId, doneAt])
  @@map("lead_task")
}

// ---- Producer (public story) ----

model Producer {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  region           String?
  productionMethod String?
  geoIndication    String?
  imageUrl         String?
  story            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products Product[]

  @@map("producer")
}

// ---- Category tree ----

model Category {
  id              String     @id @default(cuid())
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  name            String
  slug            String     @unique
  sortOrder       Int        @default(0)
  metaTitle       String?
  metaDescription String?
  canonicalPath   String?
  imageUrl        String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  productLinks     ProductCategory[]
  primaryProducts  Product[]         @relation("PrimaryCategory")
  attributes       CategoryAttribute[]
  interestedLeads  Lead[]

  @@map("category")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_category")
}

// ---- Catalog: Product + Variant ----

enum PackagingType {
  TENEKE
  VAKUM
  KOLI
  KUTU
  DOKME
}

enum BaseUnit {
  KG
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @default("")
  imageUrl          String?
  active            Boolean  @default(true)
  producerId        String
  producer          Producer @relation(fields: [producerId], references: [id])
  primaryCategoryId String
  primaryCategory   Category @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id])
  storageCondition  String?
  shelfLifeDays     Int?
  requiresColdChain Boolean  @default(true)
  usageTips         String   @default("")
  techSheetUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categories       ProductCategory[]
  variants         ProductVariant[]
  media            ProductMedia[]
  attributeValues  ProductAttributeValue[]
  postLinks        ContentPostProduct[]
  recipeLinks      RecipeProduct[]

  @@map("product")
}

model ProductVariant {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String        @unique
  barcode            String?
  packagingType      PackagingType @default(KOLI)
  packSize           String?
  baseUnit           BaseUnit      @default(KG)
  unitFactor         Decimal       @db.Decimal(10, 3)
  moq                Int           @default(1)
  pricePerUnitKurus  Int
  vatRateBasisPoints Int           @default(100)
  isActive           Boolean       @default(true)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lots           Lot[]
  priceListItems PriceListItem[]
  cartLines      CartLine[]
  shipments      Shipment[]
  orderLines     OrderLine[]

  @@map("product_variant")
}

enum MediaKind {
  IMAGE
  VIDEO
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  kind      MediaKind @default(IMAGE)
  alt       String?
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([productId, sortOrder])
  @@map("product_media")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model AttributeDefinition {
  id         String        @id @default(cuid())
  key        String        @unique
  name       String
  type       AttributeType @default(TEXT)
  unit       String?
  filterable Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  options       AttributeOption[]
  categoryLinks CategoryAttribute[]
  values        ProductAttributeValue[]

  @@map("attribute_definition")
}

model AttributeOption {
  id          String              @id @default(cuid())
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  label       String
  sortOrder   Int                 @default(0)

  selected ProductAttributeSelectedOption[]

  @@unique([attributeId, value])
  @@map("attribute_option")
}

model CategoryAttribute {
  id          String              @id @default(cuid())
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  required    Boolean             @default(false)

  @@unique([categoryId, attributeId])
  @@map("category_attribute")
}

model ProductAttributeValue {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId   String
  attribute     AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueText     String?
  valueNumber   Decimal?            @db.Decimal(12, 3)
  valueBoolean  Boolean?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  selectedOptions ProductAttributeSelectedOption[]

  @@unique([productId, attributeId])
  @@map("product_attribute_value")
}

model ProductAttributeSelectedOption {
  id      String                @id @default(cuid())
  valueId String
  value   ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  optionId String
  option  AttributeOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([valueId, optionId])
  @@map("product_attribute_selected_option")
}

// ---- Inventory ----

model Lot {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lotNumber      String
  expirationDate DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  movements   StockMovement[]
  cartLines   CartLine[]
  allocations ShipmentLotAllocation[]

  @@unique([variantId, lotNumber])
  @@map("lot")
}

enum StockMovementType {
  GIRIS
  CIKIS
  REPACK
}

model StockMovement {
  id         String            @id @default(cuid())
  lotId      String
  lot        Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type       StockMovementType
  quantityKg Decimal           @db.Decimal(10, 3)
  note       String?
  createdAt  DateTime          @default(now())

  @@map("stock_movement")
}

// ---- Shipments (dealer-facing dispatch tracking; FEFO-allocated) ----

enum ShipmentStatus {
  HAZIRLANIYOR
  YOLDA
  TESLIM_EDILDI
  IPTAL
}

model Shipment {
  id          String         @id @default(cuid())
  dealerId    String
  dealer      Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  quantityKg  Decimal        @db.Decimal(10, 3)
  status      ShipmentStatus @default(HAZIRLANIYOR)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  shippedAt   DateTime?
  deliveredAt DateTime?

  allocations ShipmentLotAllocation[]

  @@index([dealerId, createdAt])
  @@map("shipment")
}

model ShipmentLotAllocation {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id])
  quantityKg Decimal  @db.Decimal(10, 3)

  @@map("shipment_lot_allocation")
}

// ---- Pricing ----

model PriceList {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PriceListItem[]
  users   User[]
  dealers Dealer[]

  @@map("price_list")
}

model PriceListItem {
  id          String         @id @default(cuid())
  priceListId String
  priceList   PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceKurus  Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([priceListId, variantId])
  @@map("price_list_item")
}

// ---- Payment settings ----

model PaymentSettings {
  id                  String   @id @default("singleton")
  bankTransferEnabled Boolean  @default(false)
  bankName            String   @default("")
  accountHolder       String   @default("")
  iban                String   @default("")
  note                String   @default("")
  updatedAt           DateTime @updatedAt

  @@map("payment_settings")
}

// ---- Server cart ----

model Cart {
  id        String   @id @default(cuid())
  /// Anonymous guest carts identified by cookie.
  guestKey  String?  @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerId  String?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  lines CartLine[]

  @@index([userId])
  @@map("cart")
}

model CartLine {
  id                 String         @id @default(cuid())
  cartId             String
  cart               Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id])
  lotId              String?
  lot                Lot?           @relation(fields: [lotId], references: [id])
  quantity           Int
  unitPriceKurus     Int
  discountBreakdown  Json           @default("[]")
  vatRateBasisPoints Int            @default(100)
  updatedAt          DateTime       @updatedAt
  createdAt          DateTime       @default(now())

  @@index([cartId, variantId])
  @@map("cart_line")
}

// ---- Orders (M4 FSM; transitions logged in OrderEvent) ----

enum OrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  dealerId   String
  dealer     Dealer      @relation(fields: [dealerId], references: [id])
  status     OrderStatus @default(SUBMITTED)
  totalKurus Int
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  lines     OrderLine[]
  events    OrderEvent[]
  shipments Shipment[]

  @@index([dealerId, createdAt])
  @@map("order")
}

model OrderLine {
  id                 String         @id @default(cuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id])
  /// Sales-unit count (e.g. tenekes/packs), NOT kg — see ProductVariant.unitFactor for kg conversion.
  quantity           Int
  unitPriceKurus     Int
  vatRateBasisPoints Int
  lineTotalKurus     Int

  @@map("order_line")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("order_event")
}

// ---- M14 Content: blog + recipes ----

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

model ContentPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  coverUrl    String?
  /// Markdown / structured prose body
  body        String        @default("")
  category    String        @default("genel")
  tags        String[]      @default([])
  authorName  String        @default("Yetiş Grup")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  readingMins Int           @default(5)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products ContentPostProduct[]
  recipes  ContentPostRecipe[]

  @@index([status, publishedAt])
  @@map("content_post")
}

model ContentPostProduct {
  id        String      @id @default(cuid())
  postId    String
  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@map("content_post_product")
}

model ContentPostRecipe {
  id       String      @id @default(cuid())
  postId   String
  post     ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([postId, recipeId])
  @@map("content_post_recipe")
}

model Recipe {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  excerpt      String           @default("")
  coverUrl     String?
  servings     Int              @default(4)
  prepMinutes  Int              @default(15)
  cookMinutes  Int              @default(30)
  difficulty   RecipeDifficulty @default(MEDIUM)
  /// JSON: [{ name, amount, unit, productSlug? }]
  ingredients  Json             @default("[]")
  /// JSON: string[]
  steps        Json             @default("[]")
  tips         String           @default("")
  authorName   String           @default("Yetiş Grup")
  isOfficial   Boolean          @default(true)
  status       ContentStatus    @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  products RecipeProduct[]
  posts    ContentPostRecipe[]

  @@index([status, publishedAt])
  @@map("recipe")
}

model RecipeProduct {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([recipeId, productId])
  @@map("recipe_product")
}

// ---- M15 SEO: redirects ----

model SeoRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@map("seo_redirect")
}
