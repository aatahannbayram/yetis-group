# PostgreSQL connection string (Hostinger VPS/managed Postgres or Neon/Supabase/Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/yetis_grup"

# better-auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Public site URL (canonical, sitemap, OG). Falls back to BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

